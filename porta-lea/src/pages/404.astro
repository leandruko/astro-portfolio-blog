---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 — No encontrado | Lensodev"
  description="Página no encontrada."
>
  <main class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <div class="w-16 h-16 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-xl mb-4 select-none">
      (•︵•)
    </div>

    <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-2">
      error 404
    </span>

    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-3">
      Página no encontrada
    </h1>

    <p class="text-sm text-zinc-500 dark:text-zinc-400 max-w-xs mb-8">
      El enlace al que intentas acceder no existe o fue reubicado.
    </p>

    <a 
      href="/" 
      class="px-5 py-2.5 rounded-full bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 font-medium text-xs shadow-xs hover:opacity-90 transition-opacity"
    >
      ← Volver al inicio
    </a>
  </main>
</BaseLayout>