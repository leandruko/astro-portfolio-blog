---
// src/components/Contact.astro
const email = "leasotompriv@gmail.com";
---

<section id="contacto" class="gsap-section w-full pt-10 sm:pt-12 pb-14 sm:pb-16 border-t border-zinc-200/70 dark:border-zinc-800/70 flex flex-col items-center text-center px-1">
  
  <!-- Icon -->
  <div class="contact-item mb-4 text-emerald-600 dark:text-emerald-400 select-none">
    <svg class="w-8 h-8 mx-auto stroke-current fill-none" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9s-9 4.03-9 9a9 9 0 0 0 9 9z" opacity="0.15" fill="currentColor"/>
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v6m0 6v6M3 12h6m6 0h6"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>
  </div>

  <h2 class="contact-item text-xl sm:text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-3">
    Conversemos
  </h2>

  <p class="contact-item text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-md mb-2 px-2">
    Disponible para oportunidades en <strong class="font-medium text-zinc-900 dark:text-zinc-200">Ingeniería de Datos (ETL/ELT, SQL, Python, Cloud)</strong> y desarrollo de aplicaciones web.
  </p>

  <p class="contact-item text-[11px] sm:text-xs font-mono text-emerald-600 dark:text-emerald-400 mb-6">
    Concepción, Chile · Remoto o Presencial
  </p>
  <!-- Primary Email Button & Direct Link -->
  <div class="contact-item w-full max-w-sm flex flex-col gap-2.5 mb-8">
    <button 
      id="copy-email-btn" 
      data-email={email}
      class="w-full py-3 px-4 rounded-xl bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-900 font-medium text-xs sm:text-sm shadow-sm transition-all cursor-pointer select-none truncate"
    >
      copiar {email}
    </button>

    <a 
      href={`mailto:${email}`}
      class="w-full py-2.5 px-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800/80 text-xs font-mono transition-colors"
    >
      enviar correo directo (mailto) ↗
    </a>
  </div>

  <!-- Direct Social Links -->
  <div class="contact-item flex flex-wrap items-center justify-center gap-3 sm:gap-5 text-xs font-mono text-zinc-500 dark:text-zinc-400">
    <a 
      href="https://github.com/leandruko" 
      target="_blank" 
      rel="noopener noreferrer"
      class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors flex items-center gap-1"
    >
      <span>GitHub</span>
      <span class="text-[10px]">↗</span>
    </a>
    <span>·</span>
    <a 
      href="https://linkedin.com/in/leasotomdev" 
      target="_blank" 
      rel="noopener noreferrer"
      class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors flex items-center gap-1"
    >
      <span>LinkedIn</span>
      <span class="text-[10px]">↗</span>
    </a>
    <span>·</span>
    <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>disponible</span>
    </span>
  </div>

</section>


<script>
  const copyBtn = document.getElementById('copy-email-btn');

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.dataset.email;
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        const originalText = copyBtn.innerText;
        copyBtn.innerText = "✓ ¡copiado al portapapeles!";

        setTimeout(() => {
          copyBtn.innerText = originalText;
        }, 2200);
      } catch (err) {
        console.error('Error al copiar: ', err);
        copyBtn.innerText = "error al copiar";
      }
    });
  }
</script>
