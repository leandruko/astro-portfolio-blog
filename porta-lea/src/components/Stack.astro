---

<section id="stack" class="gsap-section w-full pt-12 pb-16 border-t border-zinc-200/70 dark:border-zinc-800/70">
  
  <div class="gsap-section-header mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
    <div>
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
        Tecnologías &amp; Herramientas
      </h2>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 font-mono">
        // stack técnico en ingeniería de datos, cloud y desarrollo web
      </p>
    </div>
    <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
      4 áreas principales
    </span>
  </div>

  <div class="grid grid-cols-1 gap-4">
    {stackGroups.map((group) => (
      <div class="stack-group-card p-4 sm:p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-[#141417] shadow-xs">
        <div class="flex items-center justify-between gap-2 mb-3.5">
          <h3 class="text-[11px] sm:text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider truncate">
            // {group.title}
          </h3>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 flex-shrink-0">
            {group.badge}
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-2.5">
          {group.items.map((tech) => (
            <div class="tech-pill group flex items-center gap-2.5 sm:gap-3 p-2 sm:p-2.5 rounded-xl border border-zinc-200/60 dark:border-zinc-800/70 bg-zinc-50/70 dark:bg-zinc-900/50 hover:bg-white dark:hover:bg-zinc-800/90 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all cursor-default">
              <div class={`w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200/70 dark:border-zinc-700/70 flex items-center justify-center flex-shrink-0 shadow-2xs group-hover:scale-110 transition-transform ${tech.color}`} set:html={tech.icon} />
              <div class="min-w-0 flex-1">
                <p class="text-[11px] sm:text-xs font-semibold text-zinc-900 dark:text-zinc-100 leading-tight truncate">
                  {tech.name}
                </p>
                {tech.subtitle && (
                  <p class="text-[9px] sm:text-[10px] font-mono text-zinc-500 dark:text-zinc-400 truncate mt-0.5">
                    {tech.subtitle}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

</section>
