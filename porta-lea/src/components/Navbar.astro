---
// src/components/Navbar.astro
const navItems = [
  {
    name: 'sobre mí',
    shortName: 'Inicio',
    href: '#sobre-mi',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
  },
  {
    name: 'experiencia',
    shortName: 'Exp.',
    href: '#experiencia',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`
  },
  {
    name: 'tecnologías',
    shortName: 'Stack',
    href: '#stack',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`
  },
  {
    name: 'proyectos',
    shortName: 'Proyectos',
    href: '#proyectos',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`
  },
  {
    name: 'contacto',
    shortName: 'Contacto',
    href: '#contacto',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`
  },
];
---

<!-- Desktop Sticky Top Pill Navbar -->
<header class="gsap-navbar hidden sm:flex sticky top-4 z-50 w-full justify-center mb-8">
  <nav class="max-w-full flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/85 dark:bg-zinc-900/85 backdrop-blur-md border border-zinc-200/80 dark:border-zinc-800/80 shadow-sm text-xs font-medium text-zinc-600 dark:text-zinc-400">
    
    <!-- Home / Avatar Dot -->
    <a href="#sobre-mi" class="p-1 rounded-full hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors flex items-center gap-1.5 pr-2 flex-shrink-0" aria-label="Inicio">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-semibold text-zinc-900 dark:text-zinc-100 text-xs">@lensodev</span>
    </a>

    <span class="text-zinc-300 dark:text-zinc-700 select-none flex-shrink-0">|</span>

    <!-- Nav Items -->
    <div class="flex items-center gap-1">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          data-nav-link={item.href}
          class="nav-link px-2.5 py-1 rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800/70 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors text-xs whitespace-nowrap"
        >
          {item.name}
        </a>
      ))}
    </div>

    <span class="text-zinc-300 dark:text-zinc-700 select-none flex-shrink-0">|</span>

    <!-- Theme Toggle Pill Button -->
    <button 
      type="button" 
      class="theme-toggle-btn p-1.5 rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-600 dark:text-zinc-300 transition-colors cursor-pointer select-none flex-shrink-0"
      aria-label="Alternar tema"
      title="Alternar tema claro/oscuro"
    >
      <span class="dark:hidden text-xs">☼</span>
      <span class="hidden dark:inline text-xs">☽</span>
    </button>
  </nav>
</header>

<!-- Mobile Fixed Bottom Navigation Dock -->
<nav 
  aria-label="Navegación móvil"
  class="sm:hidden fixed bottom-3 inset-x-3 z-50 rounded-2xl bg-white/90 dark:bg-zinc-900/90 backdrop-blur-xl border border-zinc-200/90 dark:border-zinc-800/90 shadow-lg shadow-zinc-950/10 dark:shadow-black/40 px-1.5 py-1.5 flex items-center justify-around"
>
  {navItems.map((item) => (
    <a 
      href={item.href}
      data-nav-link={item.href}
      class="mobile-nav-link flex flex-col items-center justify-center gap-0.5 py-1 px-2 rounded-xl text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all flex-1 min-w-0"
    >
      <span set:html={item.icon} />
      <span class="text-[10px] font-medium tracking-tight truncate">{item.shortName}</span>
    </a>
  ))}

  <div class="w-px h-6 bg-zinc-200 dark:bg-zinc-800 mx-0.5 flex-shrink-0"></div>

  <!-- Mobile Theme Toggle -->
  <button 
    type="button" 
    class="theme-toggle-btn flex flex-col items-center justify-center gap-0.5 py-1 px-2.5 rounded-xl text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer select-none flex-shrink-0"
    aria-label="Alternar tema"
  >
    <span class="dark:hidden text-sm leading-none">☼</span>
    <span class="hidden dark:inline text-sm leading-none">☽</span>
    <span class="text-[10px] font-medium tracking-tight">Tema</span>
  </button>
</nav>

<script>
  // Theme toggle (both desktop and mobile buttons)
  const themeToggleBtns = document.querySelectorAll('.theme-toggle-btn');
  themeToggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });

  // Active section indicator on scroll
  const sections = document.querySelectorAll('section[id]');
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

  const setActiveLink = (id: string) => {
    const targetHref = `#${id}`;

    mobileLinks.forEach((link) => {
      const isActive = link.getAttribute('data-nav-link') === targetHref;
      link.classList.toggle('text-emerald-600', isActive);
      link.classList.toggle('dark:text-emerald-400', isActive);
      link.classList.toggle('bg-emerald-500/10', isActive);
      link.classList.toggle('text-zinc-500', !isActive);
      link.classList.toggle('dark:text-zinc-400', !isActive);
    });

    desktopLinks.forEach((link) => {
      const isActive = link.getAttribute('data-nav-link') === targetHref;
      link.classList.toggle('bg-zinc-100', isActive);
      link.classList.toggle('dark:bg-zinc-800', isActive);
      link.classList.toggle('text-zinc-950', isActive);
      link.classList.toggle('dark:text-zinc-100', isActive);
    });
  };

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target.id) {
            setActiveLink(entry.target.id);
          }
        });
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>

