---
// src/components/Exp.astro

const experiences = [
  {
    period: "2025; 2026 — Actualidad",
    role: "Desarrollador web y soporte TI",
    company: "Colegio A-Lafken",
    location: "Penco, Chile",
    current: true,
    highlights: [
      "Desarrollé un sistema de generación de horarios escolares con Google OR-Tools y una interfaz web en Next.js.",
      "Construí una intranet con Next.js y Supabase, con módulos para el control de licencias médicas y el envío de notas de estudiantes.",
      "Implementé el despliegue de la intranet en Cloudflare y realizo labores de soporte técnico y mantenimiento de equipos."
    ],
    tags: ["Next.js", "Supabase", "Google OR-Tools", "Cloudflare"]
  },
  {
    period: "Dic. 2023 — Sep. 2024",
    role: "Ingeniero de Datos (pasantía)",
    company: "GoUp Cloud",
    location: "Remoto",
    current: false,
    highlights: [
      "Desarrollé procesos en Python y OCR para extraer información desde imágenes y convertirla en datos estructurados.",
      "Utilicé Azure Functions y Blob Storage para automatizar la recepción y el procesamiento de archivos.",
      "Participé en la integración de los datos procesados con Odoo para apoyar la gestión de inventario."
    ],
    tags: ["Python", "OCR", "Azure Functions", "Blob Storage", "Odoo"]
  },
  {
    period: "Ago. 2023 — Sep. 2023",
    role: "Analista de Datos (pasantía)",
    company: "Servicios Itata SpA",
    location: "Remoto",
    current: false,
    highlights: [
      "Participé en la migración de información desde Microsoft Access hacia MySQL.",
      "Automaticé tareas de limpieza y validación de datos con Python, Pandas y SQL.",
      "Preparé dashboards de indicadores financieros en Power BI para apoyar el análisis de información."
    ],
    tags: ["Python", "Pandas", "SQL", "MySQL", "Power BI"]
  }
];

const education = [
  {
    period: "2020 — 2023",
    title: "Ingeniería en Informática",
    institution: "Duoc UC",
    location: "Concepción, Chile",
    statusText: "Titulado",
  }
];

const languages = [
  {
    name: "Español",
    level: "Nativo",
    detail: "Comunicación profesional y redacción técnica"
  },
  {
    name: "Inglés",
    level: "Intermedio - Alto",
    detail: "Lectura de documentación técnica"
  }
];
---

<section id="experiencia" class="gsap-section w-full pt-12 pb-16 border-t border-zinc-200/70 dark:border-zinc-800/70">
  
  <div class="gsap-section-header mb-8 flex items-end justify-between gap-4">
    <div>
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
        Experiencia &amp; Formación
      </h2>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 font-mono">
        // trayectoria profesional en ingeniería de datos y desarrollo web
      </p>
    </div>

  </div>

  <div class="space-y-8">
    
    <!-- Experience Timeline Section -->
    <div class="space-y-4">
      <p class="text-xs font-mono font-medium text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">
        // Experiencia laboral
      </p>

      <div class="relative pl-4 sm:pl-6 border-l border-zinc-200 dark:border-zinc-800 space-y-5">
        {experiences.map((exp) => (
          <div class="exp-card relative group">
            <!-- Timeline Dot -->
            <span class={`absolute -left-[21px] sm:-left-[29px] top-5 w-2.5 h-2.5 rounded-full border-2 border-[#fafaf9] dark:border-[#0c0c0e] transition-transform duration-300 group-hover:scale-125 ${
              exp.current 
                ? 'bg-emerald-500 ring-4 ring-emerald-500/20' 
                : 'bg-zinc-400 dark:bg-zinc-600 group-hover:bg-zinc-900 dark:group-hover:bg-zinc-200'
            }`}></span>

            <div class="p-4 sm:p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-[#141417] shadow-xs hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 mb-1.5">
                <div class="flex items-center flex-wrap gap-2">
                  <h3 class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-zinc-100">
                    {exp.role}
                  </h3>
                  {exp.current && (
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
                      Actual
                    </span>
                  )}
                </div>
                <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800/80 px-2.5 py-0.5 rounded-md w-fit">
                  {exp.period}
                </span>
              </div>

              <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 mb-3.5 font-mono">
                <span class="font-medium text-zinc-700 dark:text-zinc-300">{exp.company}</span>
                <span>·</span>
                <span>{exp.location}</span>
              </div>

              <ul class="space-y-2 text-xs sm:text-[13px] text-zinc-600 dark:text-zinc-300/90 mb-4">
                {exp.highlights.map(item => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-500 dark:text-emerald-400 select-none mt-0.5 font-bold">›</span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>

              <!-- Role Tech Pills -->
              <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-100 dark:border-zinc-800/60">
                {exp.tags.map(tag => (
                  <span class="px-2 py-0.5 rounded-md bg-zinc-100/90 dark:bg-zinc-800/70 text-[10px] font-mono text-zinc-600 dark:text-zinc-400">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Education & Languages Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
      <!-- Formación Académica -->
      <div class="flex flex-col space-y-3">
        <p class="text-xs font-mono font-medium text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">
          // Formación académica
        </p>

        {education.map((edu) => (
          <div class="exp-card flex-1 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-[#141417] flex items-center justify-between gap-3">
            <div class="flex items-start gap-3 min-w-0">
              <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-700 dark:text-zinc-300 flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-zinc-100">
                  {edu.title}
                </p>
                <p class="text-[11px] sm:text-xs text-zinc-500 dark:text-zinc-400 font-mono mt-0.5">
                  {edu.institution} · {edu.location}
                </p>
                <p class="text-[11px] text-zinc-400 dark:text-zinc-500 font-mono mt-1">
                  {edu.period}
                </p>
              </div>
            </div>

            <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex-shrink-0">
              {edu.statusText}
            </span>
          </div>
        ))}
      </div>

      <!-- Idiomas -->
      <div class="flex flex-col space-y-3">
        <p class="text-xs font-mono font-medium text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">
          // Idiomas
        </p>

        <div class="exp-card flex-1 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-[#141417] space-y-3 flex flex-col justify-center">
          {languages.map((lang) => (
            <div class="flex items-center justify-between gap-2 text-xs">
              <div class="min-w-0">
                <span class="font-semibold text-zinc-900 dark:text-zinc-100">{lang.name}</span>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 leading-snug">{lang.detail}</p>
              </div>
              <span class="px-2 py-0.5 rounded-md font-mono text-[10px] bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 flex-shrink-0">
                {lang.level}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>

</section>
